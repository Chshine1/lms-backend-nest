{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "libs/*": {
      "includeEntryExports": false,
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/*": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@types/multer", "rxjs"],
  "ignore": ["migrations/**/*.ts", "eslint-rules/**/*.mjs"],
  "ignoreBinaries": ["migrations/scripts/migrate.sh"]
}
